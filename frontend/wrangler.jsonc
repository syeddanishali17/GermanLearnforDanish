{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ustad",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  // No Workers Logs or analytics: nothing about requests is stored beyond what D1 needs.
  "observability": { "enabled": false },
  // workers.dev is the production URL; no per-version preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    // SPA: unknown paths serve index.html. /api/* runs the Worker; /sitemap* goes there too so it is a 404, not the app;
    // /audio-private/* goes there so it needs a session.
    "not_found_handling": "single-page-application",
    // No /index.html -> / redirect: the service worker cannot precache a redirected index.html.
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/sitemap*", "/audio-private/*"],
    // Lets the Worker serve login-only audio (personal phrases) after checking the session.
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ustad",
      "database_id": "c899f1e8-60d6-4f5b-9e99-bc3530e5a66b",
      "migrations_dir": "migrations"
    }
  ]
}
